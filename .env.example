APP_NAME="Maliyat Docs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# The one platform super_admin, created by `php artisan db:seed`.
#
# DEFAULT_PASSWORD is deliberately blank. The seeder refuses to run
# without it rather than inventing a credential — this account reads
# every company's books, so it does not get a fallback. It must also
# clear the same password rules the app applies to ordinary users
# (8+ characters, letters and numbers).
#
# It is used only when the account is first created. Re-seeding never
# resets an existing password.
SUPER_ADMIN_EMAIL=admin@maliyatdocs.app
DEFAULT_PASSWORD=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail.
#
# MAIL_MAILER=log sends nothing. Every message is written to
# storage/logs/laravel.log instead of being delivered, which looks
# exactly like success from inside the app: no error, no bounce, and
# no email. Set this to `smtp` on any server a real person signs up
# on. Run `php artisan mail:diagnose` to see what is actually
# configured.
MAIL_MAILER=log
# Laravel 11 replaced MAIL_ENCRYPTION with MAIL_SCHEME — it is
# MAIL_SCHEME that this version reads, not MAIL_ENCRYPTION. An
# .env carrying the old key produces no error and no warning; the
# key is simply never looked at, and the connection stays
# unencrypted. Use `smtps` for port 465, `null` (or leave unset)
# with STARTTLS on 587.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
